                "description": "Cantidad"
              },
              {
                "name": "precio",
                "data_type": "float",
                "description": "Precio"
              },
              {
                "name": "importe",
                "data_type": "float",
                "description": "Importe"
              },
              {
                "name": "dto1",
                "data_type": "float",
                "description": "Descuento %"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "validate_1",
      "type": "validate",
      "rules": [
        {
          "id": "QxcORiyrds",
          "kind": "deterministic",
          "check": {
            "type": "expression",
            "expression": "(has(data.ibruto) && type(data.ibruto) != null_type) ? [0.0, -(has(data.idto) && type(data.idto) != null_type ? num(data.idto) : 0.0)].exists(a, [0.0, (has(data.portes) && type(data.portes) != null_type ? num(data.portes) : 0.0)].exists(b, [0.0, ((has(data.tsigaus) && type(data.tsigaus) != null_type ? num(data.tsigaus) : 0.0) + (has(data.tnfu) && type(data.tnfu) != null_type ? num(data.tnfu) : 0.0) + (has(data.tgases) && type(data.tgases) != null_type ? num(data.tgases) : 0.0))].exists(c, abs(sum((has(data.lineas) && type(data.lineas) != null_type ? data.lineas : []).map(l, has(l.importe) && type(l.importe) != null_type ? num(l.importe) : 0.0)) + a + b + c - num(data.ibruto)) <= (0.005 * abs(num(data.ibruto)) < 10.0 ? 0.005 * abs(num(data.ibruto)) : 10.0)))) : true"
          },
          "name": "Líneas + portes + tasas − descuento = base imponible",
          "severity": "error"
        }
      ]
    }
  ],
  "edges": [
    {
      "branch": null,
      "source": "parse_1",
      "target": "extract_1"
    },
    {
      "branch": null,
