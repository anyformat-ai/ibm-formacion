{
  "name": "Formación IBM · Facturas sencillas (para el optimizer)",
  "description": "Mismos campos que demo_facturas, con descripciones mínimas: el punto de partida para enseñar Health y el optimizer.",
  "nodes": [
    {
      "id": "parse_1",
      "type": "parse",
      "mode": "standard"
    },
    {
      "id": "extract_1",
      "type": "extract",
      "mode": "standard",
      "extraction_schema": {
        "fields": [
          {
            "name": "total",
            "data_type": "float",
            "description": "Total"
          },
          {
            "name": "ibruto",
            "data_type": "float",
            "description": "Base imponible"
          },
          {
            "name": "portes",
            "data_type": "float",
            "description": "Portes"
          },
          {
            "name": "tnfu",
            "data_type": "float",
            "description": "Tasa NFU"
          },
          {
            "name": "tsigaus",
            "data_type": "float",
            "description": "Tasa SIGAUS"
          },
          {
            "name": "tgases",
            "data_type": "float",
            "description": "Tasa gases"
          },
          {
            "name": "idto",
            "data_type": "float",
            "description": "Descuento"
          },
          {
            "name": "lineas",
            "data_type": "object",
            "description": "Líneas de la factura",
            "nested_fields": [
              {
                "name": "albaran",
                "data_type": "string",
                "description": "Albarán"
              },
              {
                "name": "fechaalb",
                "data_type": "date",
                "description": "Fecha albarán"
              },
              {
                "name": "npedido",
